      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'inclusionai/ling-3.0-flash-fin:free', temperature: 0, messages: [{ role: 'user', content: \"You screen incoming service requests for a heating and air conditioning company.\\nDecide three things and answer with JSON only:\\n{\\\"intent\\\":\\\"quote|booking|support|other\\\",\\\"urgency\\\":\\\"today|this_week|flexible\\\",\\\"fits_service\\\":true|false,\\\"confidence\\\":0.0-1.0,\\\"quote\\\":\\\"exact sentence copied from the request\\\"}\\nThe quote MUST be copied character for character from the request text. If nothing in the text supports your decision, return an empty quote.\\n\\nRequest:\\n\" + $json.text }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "9ef76fca-dc78-4eb7-ad9f-c02ffaf2fcb3",
      "name": "AI: intent and urgency",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "your LLM provider"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Цитата модели обязана быть подстрокой исходного текста.\n// Не нашлась - решение спорное и уходит человеку, а не клиенту.\nfor (const item of $input.all()) {\n  let verdict = {};\n  try {\n    const raw = item.json.choices?.[0]?.message?.content ?? '{}';\n    verdict = JSON.parse(raw.replace(/^```json\\n?|```$/g, '').trim());\n  } catch (e) {\n    verdict = { confidence: 0, quote: '' };\n  }\n  const text = $('Normalize request').first().json.text || '';\n  const quote = (verdict.quote || '').trim();\n  const grounded = quote.length > 0 && text.includes(quote);\n\n  item.json = {\n    ...$('Normalize request').first().json,\n    intent: verdict.intent ?? 'other',\n    urgency: verdict.urgency ?? 'flexible',\n    fits_service: verdict.fits_service ?? false,\n    quote,\n    grounded,\n    // Цитата не подтвердилась - уверенность обнуляется, что бы модель ни написала.\n    confidence: grounded ? Number(verdict.confidence ?? 0) : 0,\n  };\n}\nreturn $input.all();\n"
      },
